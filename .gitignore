# Окружение и временные файлы
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Локальная база данных
*.db
*.sqlite3

# Настройки с паролями — в репозиторий не попадают никогда.
# Образец без секретов лежит в .env.example
.env

# Состояние инфраструктуры. Там адреса, идентификаторы и иногда пароли.
# На занятии 5 разберём, почему этот файл нельзя хранить рядом с кодом.
*.tfstate
*.tfstate.*
.terraform/
crash.log

# Ключи доступа
*.pem
*.key
id_rsa*

# Редакторы
.idea/
.vscode/
.DS_Store

# Локальные параметры стенда и создаваемый inventory
*.tfvars
!*.tfvars.example
infra/ansible/inventory.ini
